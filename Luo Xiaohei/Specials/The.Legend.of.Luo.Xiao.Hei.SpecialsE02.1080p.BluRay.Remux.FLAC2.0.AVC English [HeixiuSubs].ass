Dialogue: 0,0:00:19.89,0:00:21.63,Credits_H,,0,0,0,,{\fs45\fad(400,0)\pos(699.38,446.33)}The Legend of\NLuo Xiaohei\NMusic and lyrics:\NBohe Yingxiang\NVocals: Ai Suo
Dialogue: 0,0:00:21.94,0:00:26.86,MV - Hanzi,,0,0,0,,相遇 分离 快乐 忧伤
Dialogue: 0,0:00:21.94,0:00:26.86,MV - Pinyin,,0,0,0,,Xiāngyù fēnlí kuàilè yōushāng
Dialogue: 0,0:00:21.94,0:00:26.86,MV - English,,0,0,0,,Meeting and parting, joy and sadness
Dialogue: 0,0:00:27.02,0:00:31.81,MV - Hanzi,,0,0,0,,心动 慌张 希望 绝望
Dialogue: 0,0:00:27.02,0:00:31.81,MV - Pinyin,,0,0,0,,Xīndòng huāngzhāng xīwàng juéwàng
Dialogue: 0,0:00:27.02,0:00:31.81,MV - English,,0,0,0,,Heartbeats and trepidation, hope and despair
Dialogue: 0,0:00:32.25,0:00:37.02,MV - Hanzi,,0,0,0,,不管明天会变得怎样
Dialogue: 0,0:00:32.25,0:00:37.02,MV - Pinyin,,0,0,0,,Bùguǎn míngtiān huì biàn dé zěnyàng
Dialogue: 0,0:00:32.25,0:00:37.02,MV - English,,0,0,0,,Doesn't matter what tomorrow will be like
Dialogue: 0,0:00:37.27,0:00:41.39,MV - Hanzi,,0,0,0,,陪着我 轻轻地唱
Dialogue: 0,0:00:37.27,0:00:41.39,MV - Pinyin,,0,0,0,,Péizhe wǒ qīng qīng de chàng
Dialogue: 0,0:00:37.27,0:00:41.39,MV - English,,0,0,0,,Be with me, singing together softly
Dialogue: 0,0:00:42.15,0:00:47.31,MV - Hanzi,,0,0,0,,我们在静静的夜 静静地唱
Dialogue: 0,0:00:42.15,0:00:47.31,MV - Pinyin,,0,0,0,,Wǒmen zài jìng jìng de yè jìng jìng de chàng
Dialogue: 0,0:00:42.15,0:00:47.31,MV - English,,0,0,0,,In the quiet of the night, we quietly sing
Dialogue: 0,0:00:47.78,0:00:52.12,MV - Hanzi,,0,0,0,,轻轻地说出 你的梦想
Dialogue: 0,0:00:47.78,0:00:52.12,MV - Pinyin,,0,0,0,,Qīng qīng de shuō chū nǐ de mèngxiǎng
Dialogue: 0,0:00:47.78,0:00:52.12,MV - English,,0,0,0,,You softly tell me about your dreams
Dialogue: 0,0:00:52.52,0:00:57.33,MV - Hanzi,,0,0,0,,没有星星月亮的晚上
Dialogue: 0,0:00:52.52,0:00:57.33,MV - Pinyin,,0,0,0,,Méiyǒu xīngxīng yuèliàng de wǎnshàng
Dialogue: 0,0:00:52.52,0:00:57.33,MV - English,,0,0,0,,On this starless, moonless night
Dialogue: 0,0:00:57.63,0:01:01.66,MV - Hanzi,,0,0,0,,有我在你的身旁
Dialogue: 0,0:00:57.63,0:01:01.66,MV - Pinyin,,0,0,0,,Yǒu wǒ zài nǐ de shēn páng
Dialogue: 0,0:00:57.63,0:01:01.66,MV - English,,0,0,0,,I'm here by your side
Dialogue: 0,0:01:22.89,0:01:27.66,MV - Hanzi,,0,0,0,,有太多甜太多苦太多的伤
Dialogue: 0,0:01:22.89,0:01:27.66,MV - Pinyin,,0,0,0,,Yǒu tài duō tián tài duō kǔ tài duō de shāng
Dialogue: 0,0:01:22.89,0:01:27.66,MV - English,,0,0,0,,There is too much of the sweet, the bitter, and the hurt
Dialogue: 0,0:01:27.99,0:01:32.69,MV - Hanzi,,0,0,0,,你忘记了快乐也忘了忧伤
Dialogue: 0,0:01:27.99,0:01:32.69,MV - Pinyin,,0,0,0,,Nǐ wàngjìle kuàilè yě wàngle yōushāng
Dialogue: 0,0:01:27.99,0:01:32.69,MV - English,,0,0,0,,You forgot about joy and sadness
Dialogue: 0,0:01:33.02,0:01:37.78,MV - Hanzi,,0,0,0,,把我的幸福 放在你手上
Dialogue: 0,0:01:33.02,0:01:37.78,MV - Pinyin,,0,0,0,,Bǎ wǒ de xìngfú fàng zài nǐ shǒu shàng
Dialogue: 0,0:01:33.02,0:01:37.78,MV - English,,0,0,0,,I place my happiness into your hands
Dialogue: 0,0:01:38.09,0:01:42.18,MV - Hanzi,,0,0,0,,陪着我不再流浪
Dialogue: 0,0:01:38.09,0:01:42.18,MV - Pinyin,,0,0,0,,Péizhe wǒ bù zài liúlàng
Dialogue: 0,0:01:38.09,0:01:42.18,MV - English,,0,0,0,,Stay with me, and wander no more
Dialogue: 0,0:01:43.01,0:01:48.26,MV - Hanzi,,0,0,0,,我们在静静的夜 静静地唱
Dialogue: 0,0:01:43.01,0:01:48.26,MV - Pinyin,,0,0,0,,Wǒmen zài jìng jìng de yè jìng jìng de chàng
Dialogue: 0,0:01:43.01,0:01:48.26,MV - English,,0,0,0,,On a quiet night, we're singing a quiet song
Dialogue: 0,0:01:48.57,0:01:52.94,MV - Hanzi,,0,0,0,,轻轻地说出 你的梦想
